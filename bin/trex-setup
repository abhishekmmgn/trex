#!/bin/bash
# `bin/trex setup`: takes a Mac with Rex on it to a working trex. Installs what is
# missing, leaves what is there alone, and can be run again safely.
#
#   bin/trex setup [--dry-run] [--yes] [--config PATH] [--repo DIR]
#
# Checks, in order: Rex (reported, never installed), cargo, Google Chrome, the
# pinned KittyBrowser (ADR-0001, ADR-0002), then trex's config file and schema
# (ADR-0003), then the trex block in the Rex config (`bin/trex install`). Each line says "ok" (already there), "installed",
# "would" (--dry-run), "skipped" or "FAILED". Exits 1 if anything failed,
# including a kb at another commit or from another repo left in place.
#
# --dry-run  print what would be done; change nothing
# --yes      replace a KittyBrowser at another commit or from another repo without asking
#
# The pinned repo and commit are read from lua/trex/pin.lua, the one place they live.
# Test hook: TREX_APPLICATIONS (colon-separated dirs searched for Google Chrome.app).

set -u

. "$(dirname "$0")/trex-lib.sh"
APP_DIRS=${TREX_APPLICATIONS:-/Applications:$HOME/Applications}
CARGO_HOME_DIR=${CARGO_HOME:-$HOME/.cargo}

KB_REPO=$(pinned_kb REPO)
KB_PIN=$(pinned_kb PIN)
[ -n "$KB_REPO" ] && [ -n "$KB_PIN" ] || die "setup can't read the pinned kb commit from lua/trex/pin.lua"

dry=0; yes=0; passthru=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --yes|-y) yes=1; shift ;;
    --config|--repo) passthru+=("$1" "$2"); shift 2 ;;
    *) printf 'trex setup: unknown option %s\n' "$1" >&2; exit 2 ;;
  esac
done

failed=0
say() { printf '%-18s %s\n' "$1" "$2"; }
ok() { say "$1: ok" "$2"; }
would() { say "$1: would" "$2"; }
fail() { say "$1: FAILED" "$2"; failed=1; }

# Runs a command, showing it; returns its status.
run() { printf '  $ %s\n' "$*"; "$@"; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# --- rex ------------------------------------------------------------------------
if [ -x "$REX" ]; then
  ok rex "found at $REX"; have_rex=1
else
  fail rex "not found. Install Rex first (trex doesn't install it), then run setup again."; have_rex=0
fi

# --- cargo ----------------------------------------------------------------------
# Homebrew's rustup is keg-only: neither rustup nor rustup-init lands on PATH, so
# run rustup-init from its prefix. Either installer puts cargo in ~/.cargo/bin.
find_cargo() {
  command -v cargo 2>/dev/null && return 0
  [ -x "$CARGO_HOME_DIR/bin/cargo" ] && echo "$CARGO_HOME_DIR/bin/cargo"
}
cargo=$(find_cargo || true)
if [ -n "$cargo" ]; then
  ok cargo "found at $cargo"
elif [ "$dry" = 1 ]; then
  if command -v brew >/dev/null 2>&1; then
    would cargo 'install Rust with: brew install rustup && $(brew --prefix rustup)/bin/rustup-init -y --no-modify-path'
  else would cargo "install Rust with the official rustup installer (https://sh.rustup.rs)"; fi
else
  if command -v brew >/dev/null 2>&1; then
    run brew install rustup && run "$(brew --prefix rustup)/bin/rustup-init" -y --no-modify-path
  else
    printf '  $ curl https://sh.rustup.rs | sh -s -- -y\n'
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  fi
  if [ -x "$CARGO_HOME_DIR/bin/cargo" ]; then cargo=$CARGO_HOME_DIR/bin/cargo; say "cargo: installed" "$cargo"
  else fail cargo "Rust installation didn't produce $CARGO_HOME_DIR/bin/cargo"; fi
fi

# --- Google Chrome --------------------------------------------------------------
IFS=: read -r -a dirs <<<"$APP_DIRS"
find_chrome() {
  local d
  for d in "${dirs[@]}"; do [ -d "$d/Google Chrome.app" ] && { echo "$d/Google Chrome.app"; return 0; }; done
  return 1
}
chrome=$(find_chrome || true)
if [ -n "$chrome" ]; then
  ok chrome "found at $chrome"
elif [ "$dry" = 1 ]; then
  if command -v brew >/dev/null 2>&1; then would chrome "install with: brew install --cask google-chrome"
  else would chrome "download Google's official dmg and copy Google Chrome.app to ${dirs[0]}"; fi
else
  if command -v brew >/dev/null 2>&1; then
    run brew install --cask google-chrome
  else
    dmg="$tmp/googlechrome.dmg"; mnt="$tmp/mnt"; mkdir -p "$mnt"
    if run curl -fL -o "$dmg" https://dl.google.com/chrome/mac/universal/stable/GGRO/googlechrome.dmg &&
       run hdiutil attach -nobrowse -quiet -mountpoint "$mnt" "$dmg"; then
      cp -R "$mnt/Google Chrome.app" "${dirs[0]}/" 2>/dev/null ||
        { mkdir -p "$HOME/Applications" && cp -R "$mnt/Google Chrome.app" "$HOME/Applications/"; }
      hdiutil detach -quiet "$mnt" >/dev/null 2>&1
    fi
  fi
  chrome=$(find_chrome || true)
  if [ -n "$chrome" ]; then say "chrome: installed" "$chrome"; else fail chrome "Google Chrome.app not found after installing"; fi
fi

# --- KittyBrowser ---------------------------------------------------------------
# The pin is a commit on one repo (ADR-0002: the user's fork for now), so the
# install record must name both. `cargo install --git REPO --rev PIN` records
# "git+REPO?rev=PIN#PIN" ("git+REPO#PIN" without --rev).
crates2="$CARGO_HOME_DIR/.crates2.json"
kb_bin="$CARGO_HOME_DIR/bin/kb"
kb_key=$(grep -o '"kittybrowser [^"]*"' "$crates2" 2>/dev/null | head -n1 | tr -d '"')
source=${kb_key#*(}; source=${source%)}
kb_install=(install --git "$KB_REPO" --rev "$KB_PIN" --locked --force)
is_pin() { # SOURCE: whether it is $KB_PIN built from $KB_REPO
  local url=${1#git+}
  [[ "$1" == git+* ]] && [ "${1##*#}" = "$KB_PIN" ] || return 1
  url=${url%%[?#]*}; url=${url%/}; url=${url%.git}
  [ "$url" = "$KB_REPO" ]
}
install_kb() {
  if [ -z "$cargo" ]; then say "kb: skipped" "no cargo to build it with"; return; fi
  if run "$cargo" "${kb_install[@]}"; then
    say "kb: installed" "pinned commit ${KB_PIN:0:8} from $KB_REPO"
  else fail kb "cargo install failed"; fi
}
if [ -n "$kb_key" ] && is_pin "$source" && [ -x "$kb_bin" ]; then
  ok kb "pinned commit ${KB_PIN:0:8} from $KB_REPO at $kb_bin"
elif [ -z "$kb_key" ] || is_pin "$source"; then
  # Not installed, or the record says the pin but $kb_bin is gone: nothing to replace.
  if [ "$dry" = 1 ]; then would kb "cargo ${kb_install[*]}"; else install_kb; fi
else
  if [ "$dry" = 1 ]; then
    would kb "replace the installed KittyBrowser ($source) with the pinned commit ${KB_PIN:0:8} from $KB_REPO (asks first unless --yes)"
  else
    answer=n
    if [ "$yes" = 1 ]; then answer=y
    else
      printf 'kb: the installed KittyBrowser is %s, not the pinned commit %s from %s. Replace it? [y/N] ' "$source" "$KB_PIN" "$KB_REPO"
      read -r answer || [ -n "$answer" ] || answer=n
      echo
    fi
    case "$answer" in
      y|Y|yes) install_kb ;;
      *) fail kb "left $source in place. trex won't work until it is the pinned commit from $KB_REPO: rerun setup and answer y, or use --yes" ;;
    esac
  fi
fi

# --- trex config ----------------------------------------------------------------
# $XDG_CONFIG_HOME/trex/config.json, written out with every default, and the schema
# beside it. An existing config is the user's and is never touched; the schema is
# ours, so it is refreshed when it differs.
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/trex"
config_file="$config_dir/config.json"
schema_src="$TREX_DIR/lua/trex/config.schema.json"
if [ -f "$config_file" ] && cmp -s "$schema_src" "$config_dir/config.schema.json"; then
  ok config "$config_file"
elif [ "$dry" = 1 ]; then
  would config "create $config_file and $config_dir/config.schema.json where missing or out of date"
elif mkdir -p "$config_dir" && { [ -f "$config_file" ] || cp "$TREX_DIR/lua/trex/config.default.json" "$config_file"; } &&
     cp "$schema_src" "$config_dir/config.schema.json"; then
  say "config: installed" "$config_file"
else
  fail config "couldn't write to $config_dir"
fi

# --- trex block -----------------------------------------------------------------
if [ "$have_rex" != 1 ]; then
  say "trex block: skipped" "needs Rex"
elif [ "$dry" = 1 ]; then
  would "trex block" "run: bin/trex install ${passthru[*]:-}"
elif out=$("$TREX_DIR/bin/trex" install ${passthru[@]+"${passthru[@]}"} 2>&1); then
  case "$out" in
    *"already up to date"*) ok "trex block" "already up to date" ;;
    *) say "trex block: installed" "$(printf '%s' "$out" | head -n1)" ;;
  esac
else
  fail "trex block" "$out"
fi

exit "$failed"
